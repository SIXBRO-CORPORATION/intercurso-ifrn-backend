POSTGRES_DB=intercurso_db
POSTGRES_USER=intercurso
POSTGRES_PASSWORD=intercurso
DATABASE_URL=postgresql+asyncpg://intercurso:intercurso@postgres:5432/intercurso_db
DATABASE_URL_SYNC=postgresql+psycopg2://intercurso:intercurso@postgres:5432/intercurso_db

SUAP_CLIENT_ID=suap_client_id
SUAP_CLIENT_SECRET=suap_client_secret
SUAP_REDIRECT_URI_WEB=http://localhost:3000/auth/callback
SUAP_REDIRECT_URI_MOBILE=http://localhost:8000/api/auth/callback

JWT_SECRET_KEY=dev_jwt_key
LIVE_TICKET_SECRET_KEY=dev_live_ticket_key
FRONTEND_URL=http://localhost:3000

MOBILE_DEEP_LINK_SCHEME=myapp
MOBILE_DEEP_LINK_PATH=callback

# Cloudflare R2 (use um bucket de teste, nunca o de producao)
R2_ACCOUNT_ID=r2_account_id
R2_ACCESS_KEY_ID=r2_access_key_id
R2_SECRET_ACCESS_KEY=r2_secret_access_key
R2_BUCKET_NAME=intercurso-dev
R2_ENDPOINT_URL=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PRESIGNED_URL_EXPIRES_SECONDS=3600
